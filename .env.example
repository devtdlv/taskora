# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection used by the app. In production, use the pooled
# connection string (add ?pgbouncer=true for PgBouncer in transaction mode).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/taskora"

# Direct (non-pooled) connection used by Prisma Migrate. Only needed when
# DATABASE_URL is pooled. Leave unset locally.
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/taskora"

# Public URL of the app, with no path. Login and signup only accept requests
# from this origin in production, and every link in an email points here.
# Production must use https.
APP_URL="http://localhost:3000"

# Secret used to hash rate-limit keys (HMAC-SHA-256), so emails and IP
# addresses can't be recovered from the rate_limits table. At least 32
# characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# If it's missing, rate-limited actions are refused. Changing it resets all
# counters.
RATE_LIMIT_SECRET=""

# Resend API key (https://resend.com/api-keys). Server-side only: never give it
# a NEXT_PUBLIC_ prefix.
RESEND_API_KEY="re_your_api_key"

# Sender for authentication emails.
#
# Local development: Resend's testing sender only delivers to the email address
# of your own Resend account, so other recipients are rejected. It is refused
# whenever NODE_ENV is production (next build / next start and every Vercel
# deployment), so it only works under npm run dev.
#
# Production: use an address on a domain verified in Resend, for example
# "Taskora <no-reply@your-verified-domain.com>".
EMAIL_FROM="Taskora <onboarding@resend.dev>"

# Requires a verified email address before using workspaces, projects, tasks,
# comments, and invitations. Off unless set to exactly "true". Only turn it on
# once verification emails can reach every user, or unverified accounts will
# be locked out.
ENFORCE_EMAIL_VERIFICATION="false"
